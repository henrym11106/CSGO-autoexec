// General steam linux launch options
//
SDL_AUDIO_DRIVER=pipewire // SDL3
SDL_VIDEO_DRIVER=wayland // wayland native, SDL3
SDL_VIDEO_DRIVER=x11 // default CS2, SDL3
SDL_AUDIODRIVER=pipewire // SDL2
SDL_AUDIODRIVER=pulse // SDL2 - try if pipewire cannot directly handle game audio
SDL_VIDEODRIVER=wayland // SDL2
SDL_VIDEODRIVER=x11 // SDL2. CSGO cannot do Wayland, Momentum Mod doesn't scale with Wayland.
//
LD_PRELOAD="/usr/lib/libSDL3.so.0" // may fix mouse input/sens if broken, also does the next command
LD_PRELOAD="" // don't load other stuff, including steam overlay
vk-layer-flimes 144 // external Vulkan FPS limiter vk-layer-flimes
strangle 144 --vulkan-only // external FPS limiter libstrangle
ionice -c 2 -n 2 // set IO priority: -c = class; 1=realtime, 2=best-effort and -n = level; max prio =0, min =7.
chrt -f 42  // set realtime CPU priority: -f FIFO or -r Round-Robin, min prio 1, max 99 but stay below 49; ideally 42 max.
taskset -c 1-5 // or e.g. 2,4,6 (etc.) lock process to these CPU cores. run "chrt --help" for more info

nonstandard Linux user permissions are required to set FIFO scheduling here. see:
https://wiki.archlinux.org/title/Realtime_process_management#Configuring_PAM
https://wiki.archlinux.org/title/Gaming#Improving_frame_rates_and_responsiveness_with_scheduling_policies
https://wiki.archlinux.org/title/Users_and_groups#Group_management
https://wiki.archlinux.org/title/Limits.conf


