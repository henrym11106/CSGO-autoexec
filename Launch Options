// General steam linux launch options
//
SDL_AUDIO_DRIVER=pipewire // SDL3
SDL_VIDEO_DRIVER=wayland // wayland native, SDL3
SDL_VIDEO_DRIVER=x11 // default CS2, SDL3
SDL_AUDIODRIVER=pipewire // SDL2
SDL_VIDEODRIVER=wayland // SDL2
SDL_VIDEODRIVER=x11 // SDL2. CSGO cannot do Wayland, momentum doesn't scale with Wayland.
//
LD_PRELOAD="/usr/lib/libSDL3.so.0" // may fix mouse input/sens if broken, also does the next command
LD_PRELOAD="" // don't load other stuff, including steam overlay
vk-layer-flimes 144.44 // external Vulkan FPS limiter vk-layer-flimes
strangle 144.44 --vulkan-only // external FPS limiter libstrangle
ionice -c 2 -n 2 // set IO priority: -c = class; 1=realtime, 2=best-effort and -n = level; max prio =0, min =7.
chrt -f 42  // set realtime CPU priority: -f FIFO or -r Round-Robin, min prio 1, max 99 but stay below 50; ideally 42 max.
taskset -c 1-5 // lock process to these CPU cores


// AMDGPU - some commands may be different on other drivers
//
RADV_PERFTEST=localbos,nircache,nogttspill,sam
RADV_EXPERIMENTAL=sparse,video_decode,video_encode
RADV_DEBUG=nodcc,nodisplaydcc,nofmask,zerovram
AMD_DEBUG=
radeonsi_clamp_div_by_zero
radeonsi_zerovram


// KDE Wayland, run "kscreen-doctor -o" in console to ID your displays
//
kscreen-doctor // followed by a space separated list of commands
output.DP-1.mode.1920x1080@120 // set output resolution and refresh rate
output.DP-1.colorPowerTradeoff.preferAccuracy // potentially significant performance hit from color correction
output.DP-1.colorPowerTradeoff.preferEfficiency // minimal performance hit from color correction
output.DP-1.iccprofile.$HOME/icc_current.icc // load this icc profile; this is a link to my active ICC profile
output.DP-1.iccprofile."" // leave blank to use no profile and allow direct scan out.

verify KDE Wayland direct scanout by opening "kwin debug console" enabling effect "showcompositing" and closing debug window.
leaving the debug window open requires compositing.
the red "compositing" overlay in the top right disappears when direct scanout is active.
color management and desktop effects can prevent direct scanout and degrade performance, especially with preferAccuracy/"Prefer Color Accuracy" enabled.
